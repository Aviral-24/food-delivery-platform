{
  "name": "food-delivery-platform",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@9.15.0",
 "scripts": {
  "dev": "pnpm --parallel -r dev",
  "dev:backend": "pnpm --filter food-delivery-backend dev",
  "dev:web": "pnpm --filter food-delivery-web dev",
  "generate:api-client": "pnpm --filter @food-delivery/shared generate:client",
  "lint": "pnpm -r --if-present lint",
  "test": "pnpm -r --if-present test",
  "seed": "pnpm --filter food-delivery-backend seed",
  "prepare": "husky"
},
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "husky": "^9.1.7"
  }
}